":\"center\",\"level\":1,\"dsgoAnimationEnabled\":true,\"dsgoEntranceAnimation\":\"fadeInUp\",\"dsgoAnimationDelay\":100} -->\n<h1\n      class=\"wp-block-heading has-text-align-center has-dsgo-animation dsgo-animation-fadeInUp\"\n      data-dsgo-animation-enabled=\"true\"\n      data-dsgo-entrance-animation=\"fadeInUp\"\n      data-dsgo-animation-delay=\"100\"\n    >Shipping &amp; Delivery</h1>\n<!-- /wp:heading -->\n    \n<!-- wp:paragraph {\"align\":\"center\",\"dsgoAnimationEnabled\":true,\"dsgoEntranceAnimation\":\"fadeInUp\",\"dsgoAnimationDelay\":200} -->\n<p\n      class=\"has-text-align-center has-dsgo-animation dsgo-animation-fadeInUp\"\n      data-dsgo-animation-enabled=\"true\"\n      data-dsgo-entrance-animation=\"fadeInUp\"\n      data-dsgo-animation-delay=\"200\"\n    >Information about shipping options, delivery timing, and charges.</p>\n<!-- /wp:paragraph -->\n  </div>\n  <div\n    class=\"dsgo-shape-divider dsgo-shape-divider--bottom is-shape-inherit is-flip-y\"\n    aria-hidden=\"true\"\n  ></div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"shapeDividerBottom\":\"inherit\",\"metadata\":{\"name\":\"About - Long-Form Narrative\",\"description\":\"Centered single-column narrative layout with eyebrow, heading, lead paragraph, pull quote, and body copy\",\"sophisticationTier\":1,\"industries\":[\"saas\",\"b2b\",\"ecommerce\",\"hospitality\",\"health\",\"creative\",\"legal\",\"fitness\",\"bridal\",\"education\"],\"vibes\":[\"professional\",\"editorial\",\"minimal\"],\"background\":[\"light-background\"],\"cardStyle\":[\"no-cards\"]},\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|30\"}}},\"className\":\"is-style-shape-divider airo-section-a69b4063-a59d-41b2-b58c-fe7d8d97da77 is-style-section-2\",\"anchor\":\"a69b4063-a59d-41b2-b58c-fe7d8d97da77\"} -->\n<div\n  class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-shape-divider dsgo-stack--has-shape-divider airo-section-a69b4063-a59d-41b2-b58c-fe7d8d97da77 is-style-section-2\"\n  style=\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--30)\"\n id=\"a69b4063-a59d-41b2-b58c-fe7d8d97da77\">\n  <div\n    class=\"dsgo-stack__inner\"\n    style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\"\n  >\n  \n<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"contentSize\":\"720px\"}} -->\n<div class=\"wp-block-group\">\n\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":6} -->\n<h6 class=\"wp-block-heading has-text-align-center\">Delivery information</h6>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Shipping details</h2>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Shipping Coverage</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Shipping availability is confirmed during checkout based on the delivery address.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Order Processing</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Orders are generally processed after payment/order confirmation. Processing and dispatch timelines may vary depending on order volume and product availability.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Delivery Time</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Estimated delivery timing depends on the destination, courier availability, and other logistical factors. Please use the estimated delivery date shown at checkout or in your order confirmation where available.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Shipping Charges</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Any applicable shipping charges are shown during checkout or in the order summary before the order is placed.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Order Tracking</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Tracking information will be provided when available after dispatch.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Delivery Issues</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>If an order is delayed, damaged, or appears undelivered, please contact Youth Face for assistance.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Address Accuracy</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Please provide a complete and accurate delivery address and phone number when placing your order.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Business Details</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Youth Face is a brand operated by Beauty Mart.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p>Beauty Mart<br>Azad Nagar, 4th Cross, Bhatkal, Karnataka, India<br>Phone: <a href=\"tel:+919980881230\">+91 99808 81230</a><br>Email: <a href=\"mailto:mdneehal@gmail.com\">mdneehal@gmail.com</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Customer Support</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Email: <a href=\"mailto:mdneehal@gmail.com\">mdneehal@gmail.com</a><br>WhatsApp: <a href=\"https://wa.me/919980881230\">+91 99808 81230</a><br>Call: <a href=\"tel:+919980881230\">+91 99808 81230</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>For help with shipping or delivery, please <a href=\"https://youthfacebeauty.com/contact/\">contact us</a>.</p>\n<!-- /wp:paragraph -->\n  </div>\n<!-- /wp:group -->\n  </div>\n  <div\n    class=\"dsgo-shape-divider dsgo-shape-divider--bottom is-shape-inherit is-flip-y\"\n    aria-hidden=\"true\"\n  ></div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"shapeDividerBottom\":\"inherit\",\"className\":\"is-style-shape-divider airo-section-6805f67f-f27b-4ad1-b295-597c461909cd is-style-section-1\",\"align\":\"full\",\"contentWidth\":\"600px\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|20\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"}}},\"metadata\":{\"name\":\"CTA - Centered Full Width with Headline Subheading and Button in Background Box\",\"description\":\"Centered content in rounded container with background: heading, description, and CTA button stacked vertically\",\"sophisticationTier\":1,\"industries\":[\"saas\",\"b2b\",\"ecommerce\",\"hospitality\",\"health\",\"creative\",\"legal\",\"fitness\",\"bridal\",\"education\"],\"vibes\":[\"professional\",\"modern\"],\"background\":[\"light-background\"],\"cardStyle\":[\"no-cards\"]},\"anchor\":\"6805f67f-f27b-4ad1-b295-597c461909cd\"} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-shape-divider dsgo-stack--has-shape-divider airo-section-6805f67f-f27b-4ad1-b295-597c461909cd is-style-section-1\" style=\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--20);padding-left:var(--wp--preset--spacing--30)\" id=\"6805f67f-f27b-4ad1-b295-597c461909cd\">\n  <div class=\"dsgo-stack__inner\" style=\"max-width:600px;margin-left:auto;margin-right:auto\">\n  \n<!-- wp:group -->\n<div class=\"wp-block-group\">\n    \n<!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2\n      class=\"wp-block-heading has-text-align-center\"\n    >\n      Need help with an order?\n    </h2>\n<!-- /wp:heading -->\n    \n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">For shipping and delivery questions, contact Youth Face.</p>\n<!-- /wp:paragraph -->\n    \n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div\n      class=\"wp-block-buttons\"\n    >\n      \n<!-- wp:button {\"className\":\"is-style-primary\"} -->\n<div class=\"wp-block-button is-style-primary\">\n        <a class=\"wp-block-button__link wp-element-button\" href=\"https://youthfacebeauty.com/contact/\"\n          >Contact Us</a\n        >\n      </div>\n<!-- /wp:button -->\n    </div>\n<!-- /wp:buttons -->\n  </div>\n<!-- /wp:group -->\n  </div>\n  <div class=\"dsgo-shape-divider dsgo-shape-divider--bottom is-shape-inherit is-flip-y\" aria-hidden=\"true\"></div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:html -->\n<div style=\"max-width:720px;margin:28px auto;padding:18px 20px;border:1px solid #e5e0d8;border-radius:12px;background:#faf6f2;text-align:center;\">\n<p style=\"margin:0 0 6px;font-weight:700;color:#1a1a1a;\">Related policies and help</p>\n<p style=\"margin:0;font-size:0.92em;line-height:1.8;color:#444;\"><a href=\"/privacy-policy/\" style=\"color:#1a5c33;\">Privacy Policy</a> &middot; <a href=\"/terms-conditions/\" style=\"color:#1a5c33;\">Terms and Conditions</a> &middot; <a href=\"/refund-returns-policy/\" style=\"color:#1a5c33;\">Refund &amp; Returns Policy</a> &middot; <a href=\"/security/\" style=\"color:#1a5c33;\">Security</a> &middot; <a href=\"/contact/\" style=\"color:#1a5c33;\">Contact</a> &middot; <a href=\"/sitemap/\" style=\"color:#1a5c33;\">HTML sitemap</a></p>\n</div>\n<!-- /wp:html -->"
