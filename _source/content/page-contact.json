rm and try again.\" data-submit-text=\"Send Message\"><form class=\"dsgo-form\" method=\"post\" novalidate><div class=\"dsgo-form__fields\">\n<!-- wp:designsetgo/form-text-field {\"fieldName\":\"field_117fc518\",\"label\":\"Full name\",\"placeholder\":\"Your full name\",\"required\":true} /-->\n                \n<!-- wp:designsetgo/form-email-field {\"fieldName\":\"field_ecbc26c5\",\"label\":\"Email address\",\"required\":true} /-->\n                \n<!-- wp:designsetgo/form-phone-field {\"fieldName\":\"phone-06f19e94\",\"label\":\"Phone number\",\"countryCode\":\"+91\"} /-->\n                \n<!-- wp:designsetgo/form-select-field {\"fieldName\":\"select-258d56a6\",\"label\":\"How can we help?\",\"options\":[{\"value\":\"product-question\",\"label\":\"Product question\"},{\"value\":\"order-support\",\"label\":\"Order support\"},{\"value\":\"skincare-routine\",\"label\":\"Skincare routine\"},{\"value\":\"shipping-delivery\",\"label\":\"Shipping and delivery\"},{\"value\":\"returns-refunds\",\"label\":\"Returns and refunds\"},{\"value\":\"other\",\"label\":\"Something else\"}]} /-->\n                \n<!-- wp:designsetgo/form-textarea-field {\"fieldName\":\"field_79b62438\",\"label\":\"Message\",\"placeholder\":\"Tell us how we can help\"} /-->\n</div><input type=\"text\" name=\"dsg_website\" value=\"\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\" style=\"position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden\"/><input type=\"hidden\" name=\"dsg_form_id\" value=\"contact-professional\"/><div class=\"dsgo-form__footer\"><button type=\"submit\" class=\"dsgo-form__submit wp-element-button\">Send Message</button></div><div class=\"dsgo-form__message\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" style=\"display:none\"></div></form></div>\n<!-- /wp:designsetgo/form-builder -->\n              </div>\n            </div>\n<!-- /wp:designsetgo/section -->\n          </div>\n        </div>\n<!-- /wp:designsetgo/section -->\n      </div>\