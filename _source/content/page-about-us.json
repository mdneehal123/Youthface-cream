\"dsgo-stack__inner\"\n    style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\"\n  >\n    \n<!-- wp:heading {\"textAlign\":\"center\",\"level\":6,\"dsgoAnimationEnabled\":true,\"dsgoEntranceAnimation\":\"fadeInUp\"} -->\n<h6\n      class=\"wp-block-heading has-text-align-center has-dsgo-animation dsgo-animation-fadeInUp\"\n      data-dsgo-animation-enabled=\"true\"\n      data-dsgo-entrance-animation=\"fadeInUp\"\n    ><span style=\"color:#fff\">OUR STORY</span></h6>\n<!-- /wp:heading -->\n    \n<!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"dsgoAnimationEnabled\":true,\"dsgoEntranceAnimation\":\"fadeInUp\",\"dsgoAnimationDelay\":100} -->\n<h1\n      class=\"wp-block-heading has-text-align-center has-dsgo-animation dsgo-animation-fadeInUp\"\n      data-dsgo-animation-enabled=\"true\"\n      data-dsgo-entrance-animation=\"fadeInUp\"\n      data-dsgo-animation-delay=\"100\"\n    ><span style=\"color:#fff\">About Youth Face</span></h1>\n<!-- /wp:heading -->\n    \n<!-- wp:paragraph {\"align\":\"center\",\"dsgoAnimationEnabled\":true,\"dsgoEntranceAnimation\":\"fadeInUp\",\"dsgoAnimationDelay\":200} -->\n<p\n      class=\"has-text-align-center has-dsgo-animation dsgo-animation-fadeInUp\"\n      data-dsgo-animation-enabled=\"true\"\n      data-dsgo-entrance-animation=\"fadeInUp\"\n      data-dsgo-animation-delay=\"200\"\n    ><span style=\"color:#fff\">Premium care for your everyday skincare routine.</span></p>\n<!-- /wp:paragraph -->\n  </div>\n<div class=\"dsgo-shape-divider dsgo-shape-divider--bottom is-shape-inherit is-flip-y\" aria-hidden=\"true\"></div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"className\":\"is-style-section-1\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-section-1\" style=\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--30)\">\n<div class=\"dsgo-stack__inner\" style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\">\n<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"contentSize\":\"720px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":6} -->\n<h6 class=\"wp-block-heading has-text-align-center\">OUR PURPOSE</h6>\n<!-- /wp:heading -->\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":2} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Everyday Care, Thoughtfully Made</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Youth Face is a premium Indian skincare brand centered on Youth Face Beauty Cream. We believe everyday skincare should feel simple, considered, and easy to enjoy.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Our focus is one clear product experience: helping you build a consistent skincare ritual with a cream made for your everyday routine.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\">\n<!-- wp:button {\"className\":\"is-style-primary\"} -->\n<div class=\"wp-block-button is-style-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Shop Youth Face Beauty Cream</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"className\":\"is-style-section-2\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-section-2\" style=\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--30)\">\n<div class=\"dsgo-stack__inner\" style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\">\n<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"contentSize\":\"720px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":6} -->\n<h6 class=\"wp-block-heading has-text-align-center\">OUR APPROACH</h6>\n<!-- /wp:heading -->\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":2} -->\n<h2 class=\"wp-block-heading has-text-align-center\">A Clear Skincare Ritual</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Youth Face Beauty Cream is designed to fit simply into an everyday skincare routine. Explore the product page for ingredient details, usage guidance, and available pack options.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Youth Face is a brand operated by Beauty Mart.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p class=\"has-text-align-center\">Youth Face, also written Youthface, is an Indian skincare brand from Bhatkal, Karnataka. See all <a href=\"https://youthfacebeauty.com/brand/youth-face/\">Youth Face products</a> on one page.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\"><strong>Beauty Mart</strong><br>Azad Nagar, 4th Cross, Bhatkal, Karnataka, India<br>Phone: <a href=\"tel:+919980881230\">+91 99808 81230</a><br>Email: <a href=\"mailto:mdneehal@gmail.com\">mdneehal@gmail.com</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Follow Youth Face on Instagram: <a href=\"https://www.instagram.com/youthface.beautycream/\" rel=\"me noopener\">@youthface.beautycream</a></p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"className\":\"is-style-section-1\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-section-1\" style=\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--30)\">\n<div class=\"dsgo-stack__inner\" style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\">\n<!-- wp:group {\"layout\":{\"type\":\"constrained\",\"contentSize\":\"720px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":6} -->\n<h6 class=\"wp-block-heading has-text-align-center\">OUR VALUES</h6>\n<!-- /wp:heading -->\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":2} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Focused On What Matters</h2>\n<!-- /wp:heading -->\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><li><strong>Focused routine:</strong> Youth Face Beauty Cream is our hero product for everyday skincare.</li><li><strong>Ingredient context:</strong> explore product information, including Kojic Acid and Alpha Arbutin where listed on the product page.</li><li><strong>Clear guidance:</strong> review usage, suitability, pack options, and policy information before you order.</li></ul>\n<!-- /wp:list -->\n</div>\n<!-- /wp:group -->\n</div>\n</div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"shapeDividerBottom\":\"inherit\",\"className\":\"is-style-default is-style-shape