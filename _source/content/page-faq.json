  "content": "<!-- wp:designsetgo/section {\"className\":\"is-style-section-1 airo-faq-header\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-section-1 airo-faq-header\" style=\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--30)\"><div class=\"dsgo-stack__inner\" style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":6} -->\n<h6 class=\"wp-block-heading has-text-align-center\">Youth Face</h6>\n<!-- /wp:heading -->\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\"}}}} -->\n<h1 class=\"wp-block-heading has-text-align-center\" style=\"margin-top:var(--wp--preset--spacing--20)\">Product questions</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\"}}}} -->\n<p class=\"has-text-align-center\" style=\"margin-top:var(--wp--preset--spacing--20)\">Clear, practical guidance for Youth Face Beauty Cream.</p>\n<!-- /wp:paragraph -->\n</div></div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"className\":\"is-style-section-2 airo-faq-content\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-section-2 airo-faq-content\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--30)\"><div class=\"dsgo-stack__inner\" style=\"max-width:760px;margin-left:auto;margin-right:auto\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":2} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Before you order</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|40\"}}}} -->\n<p class=\"has-text-align-center\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--40)\">Please refer to the product packaging and Shop page for the most current product information.</p>\n<!-- /wp:paragraph -->\n<!-- wp:designsetgo/accordion {\"borderBetween\":false,\"itemGap\":\"0\",\"className\":\"is-style-accordion\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|15\"}}} -->\n<div class=\"wp-block-designsetgo-accordion dsgo-accordion dsgo-accordion--icon-right is-style-accordion\" style=\"--dsgo-accordion-gap:0\" data-allow-multiple=\"false\" data-icon-style=\"chevron\"><div class=\"dsgo-accordion__items\">\n<!-- wp:designsetgo/accordion-item {\"title\":\"What is Youth Face Beauty Cream?\",\"uniqueId\":\"youth-face-faq-1\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-1-panel\" id=\"youth-face-faq-1-header\"><span class=\"dsgo-accordion-item__title\">What is Youth Face Beauty Cream?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-1-header\" id=\"youth-face-faq-1-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Youth Face Beauty Cream is an everyday skincare product. Review the Shop page and product packaging for the current product details and full ingredient list.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"How should I use the cream?\",\"uniqueId\":\"youth-face-faq-2\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-2-panel\" id=\"youth-face-faq-2-header\"><span class=\"dsgo-accordion-item__title\">How should I use the cream?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-2-header\" id=\"youth-face-faq-2-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Apply only as directed on the product packaging. Use on clean skin and avoid contact with the eyes. If contact occurs, rinse thoroughly with water.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"Should I patch test first?\",\"uniqueId\":\"youth-face-faq-3\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-3-panel\" id=\"youth-face-faq-3-header\"><span class=\"dsgo-accordion-item__title\">Should I patch test first?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-3-header\" id=\"youth-face-faq-3-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Yes. Patch test before first use, especially if you have sensitive skin or are trying a new skincare product. Stop use if irritation occurs.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"Which skin types can use it?\",\"uniqueId\":\"youth-face-faq-4\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-4-panel\" id=\"youth-face-faq-4-header\"><span class=\"dsgo-accordion-item__title\">Which skin types can use it?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-4-header\" id=\"youth-face-faq-4-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Skin needs vary from person to person. Check the product packaging, patch test first, and choose skincare that feels comfortable for your skin.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"When can I expect results?\",\"uniqueId\":\"youth-face-faq-5\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-5-panel\" id=\"youth-face-faq-5-header\"><span class=\"dsgo-accordion-item__title\">When can I expect results?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-5-header\" id=\"youth-face-faq-5-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Results and timing can vary based on individual skin, routine, and consistent use. Youth Face does not guarantee specific results.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"How do shipping and payment work?\",\"uniqueId\":\"youth-face-faq-6\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-6-panel\" id=\"youth-face-faq-6-header\"><span class=\"dsgo-accordion-item__title\">How do shipping and payment work?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-6-header\" id=\"youth-face-faq-6-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Available shipping and payment options are shown during checkout before you place your order.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"What is your returns policy?\",\"uniqueId\":\"youth-face-faq-7\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-7-panel\" id=\"youth-face-faq-7-header\"><span class=\"dsgo-accordion-item__title\">What is your returns policy?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-7-header\" id=\"youth-face-faq-7-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Please review our <a href=\"/refund-returns-policy/\">Refund &amp; Returns Policy</a> for the current eligibility, process, and terms.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n<!-- wp:designsetgo/accordion-item {\"title\":\"How can I get order support?\",\"uniqueId\":\"youth-face-faq-8\"} -->\n<div class=\"wp-block-designsetgo-accordion-item dsgo-accordion-item dsgo-accordion-item--closed\" data-initially-open=\"false\"><div class=\"dsgo-accordion-item__header\"><button type=\"button\" class=\"dsgo-accordion-item__trigger dsgo-accordion-item__trigger--icon-right\" aria-expanded=\"false\" aria-controls=\"youth-face-faq-8-panel\" id=\"youth-face-faq-8-header\"><span class=\"dsgo-accordion-item__title\">How can I get order support?</span><span class=\"dsgo-accordion-item__icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.427 6.427l3.396 3.396a.25.25 0 00.354 0l3.396-3.396A.25.25 0 0011.396 6H4.604a.25.25 0 00-.177.427z\"></path></svg></span></button></div><div class=\"dsgo-accordion-item__panel\" role=\"region\" aria-labelledby=\"youth-face-faq-8-header\" id=\"youth-face-faq-8-panel\" hidden><div class=\"dsgo-accordion-item__content\"><!-- wp:paragraph --><p>Message us on <a href=\"https://wa.me/919980881230?text=Hi%20Youth%20Face%2C%20I%20need%20help%20with%20my%20order.\">WhatsApp</a> or visit our <a href=\"/contact/\">Contact</a> page for help before or after ordering.</p><!-- /wp:paragraph --></div></div></div>\n<!-- /wp:designsetgo/accordion-item -->\n</div></div>\n<!-- /wp:designsetgo/accordion -->\n</div></div>\n<!-- /wp:designsetgo/section -->\n\n<!-- wp:designsetgo/section {\"className\":\"is-style-section-1 airo-faq-cta\",\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack is-style-section-1 airo-faq-cta\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--30)\"><div class=\"dsgo-stack__inner\" style=\"max-width:760px;margin-left:auto;margin-right:auto\">\n<!-- wp:heading {\"textAlign\":\"center\",\"level\":2} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Ready to shop?</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\",\"bottom\":\"var:preset|spacing|30\"}}}} -->\n<p class=\"has-text-align-center\" style=\"margin-top:var(--wp--preset--spacing--20);margin-bottom:var(--wp--preset--spacing--30)\">Explore Youth Face Beauty Cream and review product details before adding it to your cart.</p>\n<!-- /wp:paragraph -->\n<!-- wp:designsetgo/icon-button {\"text\":\"Add to Cart\",\"url\":\"/shop\",\"icon\":\"arrow-right\",\"iconPosition\":\"end\",\"className\":\"is-style-primary\"} -->\n<div class=\"wp-block-designsetgo-icon-button dsgo-justify dsgo-justify--center is-style-primary\"><a class=\"dsgo-icon-button wp-block-button wp-block-button__link wp-element-button dsgo-icon-button--has-icon dsgo-icon-button--icon-end\" href=\"/shop/\" target=\"_self\"><span class=\"dsgo-icon-button__icon dsgo-lazy-icon\" data-icon-name=\"arrow-right\"></span><span class=\"dsgo-icon-button__text\">Add to Cart</span></a></div>\n<!-- /wp:designsetgo/icon-button -->\n</div></div>\n<!-- /wp:designsetgo/section -->"
}