spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\",\"left\":\"0\",\"right\":\"0\"}}},\"dsgoAnimationEnabled\":true,\"dsgoEntranceAnimation\":\"fadeInLeft\"} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack has-dsgo-animation dsgo-animation-fadeInLeft\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\" data-dsgo-animation-enabled=\"true\" data-dsgo-entrance-animation=\"fadeInLeft\">\n          <div class=\"dsgo-stack__inner\" style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\">\n            \n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Let’s Talk Skincare</h2>\n<!-- /wp:heading -->\n            \n<!-- wp:paragraph {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\"}}}} -->\n<p style=\"margin-top:var(--wp--preset--spacing--20)\">Contact Youth Face for help with Youth Face Beauty Cream, your order, shipping, delivery, or returns. For quick answers, visit our <a href=\"/faq/\">FAQ</a>. For return eligibility and steps, read our <a href=\"/refund-returns-policy/\">Refund &amp; Returns Policy</a>.</p>\n<!-- /wp:paragraph -->\n            \n<!-- wp:designsetgo/section {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\"}}}} -->\n<div class=\"wp-block-designsetgo-section alignfull dsgo-stack\" style=\"padding-top:var(--wp--preset--spacing--30)\">\n              <div class=\"dsgo-stack__inner\" style=\"max-width:var(--wp--style--global--content-size, 1140px);margin-left:auto;margin-right:auto\">\n                \n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Customer Support</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Email: <a href=\"mailto:mdneehal@gmail.com\">mdneehal@gmail.com</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Call: <a href=\"tel:+919980881230\">+91 99808 81230</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Business Details</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Youth Face is a brand operated by Beauty Mart.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Beauty Mart<br>Azad Nagar, 4th Cross, Bhatkal, Karnataka, India</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Phone: <a href=\"tel:+919980881230\">+91 99808 81230</a><br>Email: <a href=\"mailto:mdneehal@gmail.com\">mdneehal@gmail.com</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Instagram: <a href=\"https://www.instagram.com/youthface.beautycream/\" rel=\"me noopener\">@youthface.beautycream</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:designsetgo/row {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\",\"left\":\"0\",\"right\":\"0\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-designsetgo-row alignfull dsgo-flex dsgo-no-width-constraint\" style=\"padding-top:0;padding-right:0;padding-bottom:0;padding-left:0\"><div class=\"dsgo-flex__inner\" style=\"display:flex;justify-content:left;flex-wrap:nowrap\">\n<!-- wp:designsetgo/icon {\"icon\":\"phone\",\"iconSize\":32} -->\n<div class=\"wp-block-designsetgo-icon dsgo-icon\" style=\"display:flex;align-items:center;justify-content:center\"><div class=\"dsgo-icon__wrapper dsgo-lazy-icon\" style=\"width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border-radius:inherit\" data-icon-name=\"phone\" data-icon-style=\"filled\" data-icon-stroke-width=\"1.5\" role=\"img\" aria-label=\"Phone\"></div></div>\n<!-- /wp:designsetgo/icon -->\n                \n<!-- wp:paragraph -->\n<p><a href=\"https://wa.me/919980881230?text=Hi%20Youth%20Face%2C%20I%E2%80%99m%20interested%20in%20ordering%20the%20Youth%20Face%20Beauty%20Cream.\">WhatsApp: +91 99808 81230</a></p>\n<!-- /wp:paragraph -->\n</div></div>\n<!-- /wp:designsetgo/row -->\n                \n              </div>\n            </div>\n<!-- /wp:designsetgo/section -->\n          </div>\n        </div>\n<!-- /w